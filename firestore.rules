rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Members collection: Public read & create/update, prevent public delete
    match /members/{memberId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }
    
    // Private Messages: Public read & create, prevent public delete
    match /messages/{messageId} {
      allow read, create: if true;
      allow update, delete: if false;
    }

    // Village Hut Posts: Public read & create, prevent public delete
    match /village_hut_posts/{postId} {
      allow read, create, update: if true;
      allow delete: if false;
    }
    
    // Default fallback: allow read/write for app features, disallow delete
    match /{document=**} {
      allow read, create, update: if true;
      allow delete: if false;
    }
  }
}
